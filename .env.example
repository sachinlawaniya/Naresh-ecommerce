# ==========================================
# ENTERPRISE E-COMMERCE ENVIRONMENT CONFIG
# ==========================================

# Server Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Supabase / Local)
# Connection pooling URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct database URL for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Upstash Redis (Caching, Rate Limiting & Inventory Locks)
UPSTASH_REDIS_REST_URL="https://[YOUR-REDIS-ID].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-TOKEN]"

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Resend Transactional Emails
RESEND_API_KEY="re_..."
EMAIL_FROM="orders@yourbrand.com"

# GST & Store Identity Configuration
NEXT_PUBLIC_STORE_NAME="LUXE VOGUE"
NEXT_PUBLIC_STORE_CURRENCY="INR"
STORE_ORIGIN_STATE="Karnataka"
STORE_GSTIN="29AAAAA0000A1Z5"
