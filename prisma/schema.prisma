datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & ACCESS CONTROL (RBAC)
// ==========================================

enum RoleType {
  SUPER_ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  SUPPORT_AGENT
  CUSTOMER
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  authId          String        @unique // Supabase auth.users.id
  email           String        @unique
  phone           String?       @unique
  firstName       String
  lastName        String?
  avatarUrl       String?
  role            RoleType      @default(CUSTOMER)
  isActive        Boolean       @default(true)
  isEmailVerified Boolean       @default(false)

  addresses       Address[]
  orders          Order[]
  wishlists       Wishlist[]
  reviews         Review[]
  auditLogs       AuditLog[]
  assignedLeads   Lead[]        @relation("AssignedAgent")
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([email])
  @@index([role])
}

model Address {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName     String
  phone             String
  streetLine1       String
  streetLine2       String?
  city              String
  state             String    // State name / code for GST calculation
  postalCode        String
  country           String    @default("India")
  isDefaultBilling  Boolean   @default(false)
  isDefaultShipping Boolean   @default(false)

  ordersAsShipping  Order[]   @relation("ShippingAddress")
  ordersAsBilling   Order[]   @relation("BillingAddress")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

// ==========================================
// 2. PRODUCT CATALOG & VARIANT MATRIX
// ==========================================

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?
  parentId    String?       @db.Uuid
  parent      Category?     @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]    @relation("SubCategories")
  products    Product[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
}

model Brand {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  slug        String        @unique
  logoUrl     String?
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Collection {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  slug        String              @unique
  description String?
  bannerUrl   String?
  isActive    Boolean             @default(true)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([slug])
}

model ProductCollection {
  productId    String       @db.Uuid
  collectionId String       @db.Uuid
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Product {
  id             String              @id @default(uuid()) @db.Uuid
  title          String
  slug           String              @unique
  description    String              @db.Text
  categoryId     String              @db.Uuid
  category       Category            @relation(fields: [categoryId], references: [id])
  brandId        String?             @db.Uuid
  brand          Brand?              @relation(fields: [brandId], references: [id])
  
  hsnCode        String              @default("61091000") // HSN for apparel
  gstRate        Decimal             @default(5.00) @db.Decimal(5, 2)
  
  isPublished    Boolean             @default(false)
  isFeatured     Boolean             @default(false)
  
  variants       ProductVariant[]
  collections    ProductCollection[]
  reviews        Review[]
  wishlists      Wishlist[]
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
}

model ProductVariant {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku            String          @unique // E.g., TS-OVR-BLK-L
  barcode        String?         @unique
  colorName      String          // Black, White, Navy
  colorHex       String          // #000000
  size           String          // S, M, L, XL, XXL
  
  basePrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal?        @db.Decimal(10, 2)
  costPrice      Decimal?        @db.Decimal(10, 2)
  weightGrams    Int             @default(250)
  
  images         VariantImage[]
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sku])
  @@index([productId])
  @@unique([productId, colorName, size])
}

model VariantImage {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int            @default(0)

  @@index([variantId])
}

// ==========================================
// 3. WAREHOUSE & INVENTORY MANAGEMENT
// ==========================================

model Warehouse {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String          @unique // E.g., WH-BLR-01
  addressState   String          // Operating origin state for GST origin
  city           String
  postalCode     String
  isActive       Boolean         @default(true)
  inventoryItems InventoryItem[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model InventoryItem {
  id               String         @id @default(uuid()) @db.Uuid
  variantId        String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId      String         @db.Uuid
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  lowStockAlert    Int            @default(5)
  
  updatedAt        DateTime       @updatedAt

  @@unique([variantId, warehouseId])
  @@index([variantId])
}

// ==========================================
// 4. COUPONS & PROMOTIONS
// ==========================================

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderValue  Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int          @default(0)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(true)
  orders         Order[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([code])
}

// ==========================================
// 5. ORDERS, GST INVOICING & PAYMENTS
// ==========================================

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY_UPI
  RAZORPAY_CARD
  RAZORPAY_NETBANKING
  RAZORPAY_WALLET
  COD
}

model Order {
  id                String         @id @default(uuid()) @db.Uuid
  orderNumber       String         @unique // E.g., ORD-2026-10001
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id])
  
  status            OrderStatus    @default(PENDING_PAYMENT)
  
  shippingAddressId String         @db.Uuid
  shippingAddress   Address        @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String         @db.Uuid
  billingAddress    Address        @relation("BillingAddress", fields: [billingAddressId], references: [id])
  
  couponId          String?        @db.Uuid
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  
  // Financial Breakdowns
  subTotal          Decimal        @db.Decimal(10, 2)
  discountTotal     Decimal        @default(0) @db.Decimal(10, 2)
  shippingTotal     Decimal        @default(0) @db.Decimal(10, 2)
  
  // GST Tax Computations
  taxableAmount     Decimal        @db.Decimal(10, 2)
  cgstTotal         Decimal        @default(0) @db.Decimal(10, 2)
  sgstTotal         Decimal        @default(0) @db.Decimal(10, 2)
  igstTotal         Decimal        @default(0) @db.Decimal(10, 2)
  totalTax          Decimal        @db.Decimal(10, 2)
  grandTotal        Decimal        @db.Decimal(10, 2)
  
  items             OrderItem[]
  payments          Payment[]
  invoice           Invoice?
  
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String         @db.Uuid
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  
  sku           String
  productTitle  String
  colorName     String
  size          String
  quantity      Int
  unitPrice     Decimal        @db.Decimal(10, 2)
  
  hsnCode       String
  gstRate       Decimal        @db.Decimal(5, 2)
  cgstAmount    Decimal        @default(0) @db.Decimal(10, 2)
  sgstAmount    Decimal        @default(0) @db.Decimal(10, 2)
  igstAmount    Decimal        @default(0) @db.Decimal(10, 2)
  totalTax      Decimal        @db.Decimal(10, 2)
  totalAmount   Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  
  errorMessage      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([razorpayOrderId])
  @@index([status])
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique // E.g., INV-2627-0001
  orderId         String        @unique @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id])
  
  sellerGstin     String        // Business GSTIN
  buyerGstin      String?       // B2B optional
  placeOfSupply   String        // Buyer State
  pdfUrl          String?
  
  issuedAt        DateTime      @default(now())

  @@index([invoiceNumber])
}

// ==========================================
// 6. CRM, LEADS & ACTIVITY LOGS
// ==========================================

enum LeadSource {
  ABANDONED_CART
  WEBSITE_SIGNUP
  CONTACT_FORM
  NEWSLETTER
}

model Lead {
  id          String         @id @default(uuid()) @db.Uuid
  email       String
  phone       String?
  name        String?
  source      LeadSource
  status      LeadStatus     @default(NEW)
  cartData    Json?          // Abandoned cart snapshot
  
  assignedTo  String?        @db.Uuid
  agent       User?          @relation("AssignedAgent", fields: [assignedTo], references: [id])
  
  activities  LeadActivity[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([email])
  @@index([status])
}

enum LeadStatus {
  NEW
  CONTACTED
  CART_ABANDONED
  CONVERTED
  LOST
}

model LeadActivity {
  id           String        @id @default(uuid()) @db.Uuid
  leadId       String        @db.Uuid
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note         String
  activityType String        // CALL, EMAIL_SENT, WHATSAPP, NOTE
  createdAt    DateTime      @default(now())
}

// ==========================================
// 7. WISHLIST, REVIEWS & AUDIT LOGS
// ==========================================

model Wishlist {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String    @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, productId])
}

model Review {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String    @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int       // 1 to 5
  comment   String?   @db.Text
  isVerified Boolean  @default(false)
  createdAt DateTime  @default(now())

  @@index([productId])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String    // E.g., UPDATE_PRICE, REFUND_ISSUED, ROLE_CHANGE
  entityType  String    // E.g., ProductVariant, Order, User
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
